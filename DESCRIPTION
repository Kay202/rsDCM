Package: dcmR
Type: Package
Title: Dynamic Causal Modelling for Functional MRI
Version: 0.1.0
Authors@R: c(
    person(given = "Godfred", family = "Arhin",
           email = "arhin0122@gmail.com",
           role = c("aut", "cre")),
    person(given = "Nilotpal", family = "Sanyal",
