Package: rsDCM
Type: Package
Title: Robust and Sparse Dynamic Causal Modelling for Functional MRI
Version: 0.2.0
Date: 2026-11-08
Authors@R: c(
    person(given = "Godfred", family = "Arhin",
           email = "arhin0122@gmail.com",
           role = c("aut", "cre", "trl")),
    person(given = "Nilotpal", family = "Sanyal",
           email = "nsanyal@utep.edu",
           role = "aut"),
    person(given = "SPM25 Authors", role = c("ctb", "cph"),
