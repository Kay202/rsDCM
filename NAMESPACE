importFrom(stats, lm.fit, pnorm, toeplitz, var)
importFrom(methods, as)

# Matrix S4 methods/classes — needed so that t(), %*%, solve(), nrow(),
# diag(), kronecker(), norm() dispatch correctly when called inside dcmR
# on Matrix-class objects. Without these directives the methods exist
# in Matrix's namespace but R's dispatcher can't find them from our
# functions, and t.default() rejects the argument.
importClassesFrom(Matrix,
                  Matrix,
                  sparseMatrix,
                  denseMatrix,
                  diagonalMatrix,
                  dgCMatrix,
                  dgTMatrix,
                  dgeMatrix,
                  ddiMatrix)
importMethodsFrom(Matrix,
                  t,
                  "%*%",
                  solve,
                  diag,
                  kronecker,
                  crossprod,
                  tcrossprod,
                  norm,
                  determinant)
